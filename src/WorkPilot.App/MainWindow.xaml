<Window
    x:Class="WorkPilot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" OpenPaneLength="264" CompactPaneLength="72"
                    SelectionChanged="OnSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="新任务" Tag="chat">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Add" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="任务" Tag="tasks">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="项目" Tag="projects">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="资产" Tag="assets">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="专家" Tag="experts">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="技能" Tag="skills">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="连接" Tag="connections">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="安全中心" Tag="security">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="自动化" Tag="automations">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="设置" Tag="settings">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <NavigationView.PaneHeader>
        <Grid Margin="8,8,8,14" ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="SpacePicker" MinHeight="40" DisplayMemberPath="DisplayName"
                    SelectionChanged="OnSpaceChanged" AutomationProperties.Name="当前空间" />
          <Button Grid.Column="1" Content="⋯" Width="40" Padding="0" Click="OnManageSpaces"
                  ToolTipService.ToolTip="管理空间" AutomationProperties.Name="管理空间" />
        </Grid>
      </NavigationView.PaneHeader>
      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
