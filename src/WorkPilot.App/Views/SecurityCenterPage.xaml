<Page
    x:Class="WorkPilot.Views.SecurityCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkPilot.Views"
    xmlns:sec="using:WorkPilot.App.Core.Security"
    xmlns:models="using:WorkPilot.Domain.Security"
    xmlns:gov="using:WorkPilot.Application.Security.Governance"
    xmlns:perm="using:WorkPilot.Domain.PermissionGovernance"
    xmlns:audit="using:WorkPilot.Domain.Security.Audit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:DateTimeOffsetToStringConverter x:Key="DtoToString"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:DoubleToIntConverter x:Key="DoubleToInt"/>
    </Page.Resources>

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="安全中心" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Content="刷新态势" Command="{x:Bind Vm.LoadPostureCommand}"/>
            <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="20" Height="20"/>
        </StackPanel>

        <!-- Global banners -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar Severity="Error" IsOpen="{x:Bind Vm.EmergencyStopActive, Mode=OneWay}"
                     Title="全局紧急停止已激活" Message="所有自动化执行已挂起，请评估后恢复。"/>
            <InfoBar Severity="Warning" IsOpen="{x:Bind Vm.DetectionDegraded, Mode=OneWay}"
                     Title="检测子系统降级" Message="来源健康检查不可达：0 个来源不代表安全，请检查检测器。"/>
            <InfoBar Severity="Error" IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
                     Message="{x:Bind Vm.Error.MessageKey, Mode=OneWay}"/>
        </StackPanel>

        <!-- Six tabs -->
        <TabView x:Name="TabView" Grid.Row="2" SelectionChanged="OnTabChanged">
            <TabViewItem Header="态势">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="8">
                        <TextBlock Text="态势概览" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.EmergencyStopActive, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.DetectionDegraded, Mode=OneWay}"/>
                        <TextBlock Text="已加载事件数（切换至事件页以加载）"/>
                        <TextBlock Text="{x:Bind Vm.Incidents.Items.Count, Mode=OneWay}"/>
                        <TextBlock Text="已加载来源数（切换至来源页以加载）"/>
                        <TextBlock Text="{x:Bind Vm.Sources.Health.Count, Mode=OneWay}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="事件">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="刷新" Command="{x:Bind Vm.Incidents.RefreshCommand}"/>
                            <ProgressRing IsActive="{x:Bind Vm.Incidents.IsLoading, Mode=OneWay}" Width="18" Height="18"/>
                        </StackPanel>
                        <InfoBar Severity="Error" IsOpen="{x:Bind Vm.Incidents.HasError, Mode=OneWay}"
                                 Message="{x:Bind Vm.Incidents.Error.MessageKey, Mode=OneWay}"/>
                        <InfoBar Severity="Informational" IsOpen="{x:Bind Vm.Incidents.IsEmpty, Mode=OneWay}"
                                 Message="当前没有事件。"/>
                        <ListView ItemsSource="{x:Bind Vm.Incidents.Items, Mode=OneWay}"
                                  SelectionChanged="OnIncidentSelectionChanged" MaxHeight="520">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Incident">
                                    <StackPanel Spacing="2" Padding="4">
                                        <TextBlock Text="{x:Bind Severity}"/>
                                        <TextBlock Text="{x:Bind State}"/>
                                        <TextBlock Text="{x:Bind Type}"/>
                                        <TextBlock Text="{x:Bind Count}"/>
                                        <TextBlock Text="{x:Bind LastSeenUtc, Converter={StaticResource DtoToString}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="确认" Click="OnAckIncident"/>
                                            <Button Content="缓解" Click="OnMitigateIncident"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8"
                                Visibility="{x:Bind Vm.Incidents.DrillDownOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="事件详情" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.Incidents.SelectedIncident.Severity, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.Incidents.SelectedIncident.State, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.Incidents.SelectedIncident.Fingerprint, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.Incidents.SelectedIncident.LastSeenUtc, Mode=OneWay, Converter={StaticResource DtoToString}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="确认" Click="OnAckSelectedIncident"/>
                            <Button Content="缓解" Click="OnMitigateSelectedIncident"/>
                        </StackPanel>
                        <TextBlock Text="处置结论"/>
                        <ComboBox x:Name="ResolveCodeBox"/>
                        <TextBox x:Name="ResolveNoteBox" Header="处置说明（0–500 安全字符）" AcceptsReturn="True" Height="80"/>
                        <Button Content="解决" Click="OnResolveIncident"/>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="来源生命周期">
                <StackPanel Spacing="8" Margin="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新" Command="{x:Bind Vm.Sources.RefreshCommand}"/>
                        <ProgressRing IsActive="{x:Bind Vm.Sources.IsLoading, Mode=OneWay}" Width="18" Height="18"/>
                    </StackPanel>
                    <InfoBar Severity="Error" IsOpen="{x:Bind Vm.Sources.HasError, Mode=OneWay}"
                             Message="{x:Bind Vm.Sources.Error.MessageKey, Mode=OneWay}"/>
                    <InfoBar Severity="Warning" IsOpen="{x:Bind Vm.Sources.DetectionDegraded, Mode=OneWay}"
                             Title="检测降级" Message="来源健康数据不完整，0 个来源不代表安全。"/>
                    <InfoBar Severity="Warning" IsOpen="{x:Bind Vm.Sources.PartialFailure, Mode=OneWay}"
                             Title="部分失败" Message="禁用子动作部分失败，请重试成功的子动作。"/>
                    <ListView ItemsSource="{x:Bind Vm.Sources.Health, Mode=OneWay}" MaxHeight="520">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="gov:SourceHealth">
                                <StackPanel Spacing="2" Padding="4">
                                    <TextBlock Text="{x:Bind Kind}"/>
                                    <TextBlock Text="{x:Bind Id}"/>
                                    <TextBlock Text="{x:Bind Status}"/>
                                    <TextBlock Text="{x:Bind Detail}"/>
                                    <TextBlock Text="{x:Bind ObservedAtUtc, Converter={StaticResource DtoToString}}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="禁用" Click="OnDisableSource"/>
                                        <Button Content="恢复" Click="OnRecoverSource"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="权限配置">
                <StackPanel Spacing="8" Margin="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新" Command="{x:Bind Vm.Grants.RefreshCommand}"/>
                        <ProgressRing IsActive="{x:Bind Vm.Grants.IsLoading, Mode=OneWay}" Width="18" Height="18"/>
                    </StackPanel>
                    <InfoBar Severity="Error" IsOpen="{x:Bind Vm.Grants.HasError, Mode=OneWay}"
                             Message="{x:Bind Vm.Grants.Error.MessageKey, Mode=OneWay}"/>
                    <InfoBar Severity="Warning" IsOpen="{x:Bind Vm.Grants.ImpactChanged, Mode=OneWay}"
                             Title="影响已变化" Message="自预览以来授权状态已变化，请重新预览再撤销。"/>
                    <TextBlock Text="{x:Bind Vm.Grants.PendingImpactSummary, Mode=OneWay}"/>
                    <ListView ItemsSource="{x:Bind Vm.Grants.Grants, Mode=OneWay}" MaxHeight="520">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="perm:PolicyGrant">
                                <StackPanel Spacing="2" Padding="4">
                                    <TextBlock Text="{x:Bind CapabilityStableId}"/>
                                    <TextBlock Text="{x:Bind AutomationId}"/>
                                    <TextBlock Text="{x:Bind SourceKind}"/>
                                    <TextBlock Text="{x:Bind ExpiresAtUtc, Converter={StaticResource DtoToString}}"/>
                                    <TextBlock Text="{x:Bind RiskCeiling}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="预览撤销" Click="OnPreviewGrant"/>
                                        <Button Content="撤销" Click="OnRevokeGrant"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="审计查询">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="筛选" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <ComboBox x:Name="AuditCategoryBox" Header="类别" SelectionChanged="OnAuditCategoryChanged"/>
                        <TextBox x:Name="AuditActionBox" Header="动作" Text="{x:Bind Vm.Audit.ActionFilter, Mode=TwoWay}"/>
                        <TextBox x:Name="AuditActorBox" Header="操作者" Text="{x:Bind Vm.Audit.ActorFilter, Mode=TwoWay}"/>
                        <DatePicker x:Name="AuditFromBox" Header="起（本地）" Date="{x:Bind Vm.Audit.FromUtcFilter, Mode=TwoWay}"/>
                        <DatePicker x:Name="AuditToBox" Header="止（本地）" Date="{x:Bind Vm.Audit.ToUtcFilter, Mode=TwoWay}"/>
                        <NumberBox Header="上限" Value="{x:Bind Vm.Audit.Limit, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" Minimum="1" Maximum="10000"/>
                        <Button Content="查询" Command="{x:Bind Vm.Audit.RunQueryCommand}"/>
                        <InfoBar Severity="Error" IsOpen="{x:Bind Vm.Audit.HasError, Mode=OneWay}"
                                 Message="{x:Bind Vm.Audit.Error.MessageKey, Mode=OneWay}"/>
                        <InfoBar Severity="Informational" IsOpen="{x:Bind Vm.Audit.IsEmpty, Mode=OneWay}"
                                 Message="没有匹配的审计记录。"/>
                        <ListView ItemsSource="{x:Bind Vm.Audit.Entries, Mode=OneWay}"
                                  SelectionChanged="OnAuditEntrySelectionChanged" MaxHeight="420">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="audit:AuditEntry">
                                    <StackPanel Spacing="2" Padding="4">
                                        <TextBlock Text="{x:Bind Sequence}"/>
                                        <TextBlock Text="{x:Bind OccurredAtUtc, Converter={StaticResource DtoToString}}"/>
                                        <TextBlock Text="{x:Bind Category}"/>
                                        <TextBlock Text="{x:Bind Action}"/>
                                        <TextBlock Text="{x:Bind Actor}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="决策轨迹" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBox Text="{x:Bind Vm.Audit.DecisionTrace, Mode=OneWay}"
                                 AcceptsReturn="True" IsReadOnly="True" Height="400"
                                 FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="保留 / 诊断 / 紧急停止">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="8">
                        <TextBlock Text="紧急停止" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.EmergencyStopActive, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="紧急停止" Command="{x:Bind Vm.EmergencyStopCommand}"/>
                            <Button Content="恢复" Command="{x:Bind Vm.EmergencyResumeCommand}"/>
                        </StackPanel>

                        <TextBlock Text="保留策略（doc 05 §9，SEC-106）" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="运行元数据 30–365 天；运行事件 7–90 天；安全审计/事件 90–730 天。越界值会被钳制到范围内。" TextWrapping="WrapWholeWords"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" Header="运行保留(天)" Minimum="30" Maximum="365"
                                       Value="{x:Bind Vm.Retention.RunDays, Mode=TwoWay, Converter={StaticResource DoubleToInt}}"/>
                            <NumberBox Grid.Column="1" Header="事件保留(天)" Minimum="7" Maximum="90"
                                       Value="{x:Bind Vm.Retention.EventDays, Mode=TwoWay, Converter={StaticResource DoubleToInt}}"/>
                            <NumberBox Grid.Column="2" Header="审计保留(天)" Minimum="90" Maximum="730"
                                       Value="{x:Bind Vm.Retention.AuditDays, Mode=TwoWay, Converter={StaticResource DoubleToInt}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="载入" Command="{x:Bind Vm.Retention.LoadCommand}"/>
                            <Button Content="保存" Command="{x:Bind Vm.Retention.SaveCommand}"/>
                            <Button Content="立即清理" Command="{x:Bind Vm.Retention.CleanupNowCommand}"/>
                            <ProgressRing IsActive="{x:Bind Vm.Retention.IsBusy, Mode=OneWay}" Width="18" Height="18"/>
                        </StackPanel>
                        <InfoBar Severity="Error" IsOpen="{x:Bind Vm.Retention.HasError, Mode=OneWay}"
                                 Message="{x:Bind Vm.Retention.Error.MessageKey, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.Retention.LastCleanupAtUtc, Mode=OneWay, Converter={StaticResource DtoToString}}"/>
                        <TextBlock Text="{x:Bind Vm.Retention.LastCleanupSkipped, Mode=OneWay}"/>

                        <TextBlock Text="运行报告导出（LOG-005）" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="报告仅含运行/步骤/事件的元数据与时间线，不含 prompt、参数或结果。" TextWrapping="WrapWholeWords"/>
                        <TextBox Header="运行 ID" Text="{x:Bind Vm.RunReport.RunIdText, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="导出报告" Command="{x:Bind Vm.RunReport.ExportCommand}"/>
                            <Button Content="保存为 JSON" Command="{x:Bind Vm.RunReport.SaveAsCommand}"/>
                            <ProgressRing IsActive="{x:Bind Vm.RunReport.IsBusy, Mode=OneWay}" Width="18" Height="18"/>
                        </StackPanel>
                        <TextBox Header="保存路径（本地）" Text="{x:Bind Vm.RunReport.SavePath, Mode=TwoWay}"/>
                        <InfoBar Severity="Error" IsOpen="{x:Bind Vm.RunReport.HasError, Mode=OneWay}"
                                 Message="{x:Bind Vm.RunReport.Error.MessageKey, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.RunReport.Report.Hash, Mode=OneWay}"/>

                        <TextBlock Text="支持包（doc 05 §10.2，SEC-108）" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="运行报告默认不包含，需显式勾选。支持包仅生成本地清单，不会自动上传。" TextWrapping="WrapWholeWords"/>
                        <ListView ItemsSource="{x:Bind Vm.Support.Categories, Mode=OneWay}" MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="sec:SupportPackageCategoryView">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox IsChecked="{x:Bind Include, Mode=TwoWay}" Content="{x:Bind Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBox Header="输出路径（本地）" Text="{x:Bind Vm.Support.OutputPath, Mode=TwoWay}"/>
                        <Button Content="选择文件夹" Click="OnPickOutputPath"/>
                        <Button Content="生成支持包" Command="{x:Bind Vm.Support.GenerateCommand}"/>
                        <InfoBar Severity="Error" IsOpen="{x:Bind Vm.Support.HasError, Mode=OneWay}"
                                 Message="{x:Bind Vm.Support.Error.MessageKey, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.Support.ManifestHash, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.Support.GeneratedAtUtc, Mode=OneWay, Converter={StaticResource DtoToString}}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
