<Page x:Class="WorkPilot.Views.ExpertsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:WorkPilot.Models">
  <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="专家" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="为不同工作配置独立指令、技能和外部能力" Foreground="#A8A8A8"/></StackPanel>
      <Button Grid.Column="1" Content="新建专家" Click="OnNew" Background="{StaticResource AccentGreenBrush}"/>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
        <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBox x:Name="SearchBox" PlaceholderText="搜索专家" TextChanged="OnSearch" AutomationProperties.Name="搜索专家"/>
          <ListView x:Name="ExpertList" Grid.Row="1" SelectionChanged="OnSelected">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:Expert">
              <StackPanel Padding="4,8" Spacing="3"><TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Description}" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="#B8B8B8"/>
                <TextBlock Text="{x:Bind RevisionLabel}" FontSize="11" Foreground="#8E8E8E"/></StackPanel>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
        <StackPanel x:Name="DetailPanel" Spacing="14">
          <TextBlock x:Name="NameText" Text="选择一个专家" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="#B8B8B8"/>
          <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="修订" Foreground="#888"/><TextBlock x:Name="RevisionText"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="技能" Foreground="#888"/><TextBlock x:Name="SkillCountText"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="连接" Foreground="#888"/><TextBlock x:Name="ConnectionCountText"/></StackPanel>
          </Grid>
          <TextBlock Text="系统指令摘要" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <TextBlock x:Name="InstructionText" TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="EditButton" Content="编辑" Click="OnEdit" IsEnabled="False"/>
            <Button x:Name="CopyButton" Content="复制" Click="OnCopy" IsEnabled="False"/>
            <Button x:Name="ArchiveButton" Content="归档 / 恢复" Click="OnArchive" IsEnabled="False"/>
          </StackPanel>
          <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
