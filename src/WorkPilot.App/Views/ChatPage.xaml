<Page
    x:Class="WorkPilot.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource AppBackgroundBrush}" Padding="28,20,28,24" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="WorkPilot" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#A8A8A8" FontSize="12" />
      </StackPanel>
      <ComboBox x:Name="ExpertPicker" Grid.Column="1" Width="180" PlaceholderText="专家" DisplayMemberPath="DisplayName" SelectionChanged="OnExpertChanged" AutomationProperties.Name="当前专家"/>
      <ComboBox x:Name="ConversationPicker" Grid.Column="2" Width="220" PlaceholderText="会话" SelectionChanged="OnConversationChanged" />
      <Button Grid.Column="3" Content="＋ 新任务" Click="OnNewConversation" />
    </Grid>
    <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="MessageList" MaxWidth="850" HorizontalAlignment="Stretch" Spacing="12" />
    </ScrollViewer>
    <Border Grid.Row="2" MaxWidth="850" HorizontalAlignment="Stretch" Background="{StaticResource CardBrush}"
            BorderBrush="#343434" BorderThickness="1" CornerRadius="14" Padding="14">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="PromptBox" MinHeight="92" MaxHeight="190" AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="描述一个任务，Ctrl+Enter 发送…" KeyDown="OnPromptKeyDown" />
        <Grid Grid.Row="1" ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="ProjectPicker" Width="210" PlaceholderText="不使用项目" SelectionChanged="OnProjectChanged" />
          <ComboBox x:Name="PermissionPicker" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectionChanged="OnPermissionChanged">
            <ComboBoxItem Content="默认：写入需确认" Tag="0"/><ComboBoxItem Content="只读" Tag="1"/><ComboBoxItem Content="完全访问" Tag="2"/>
          </ComboBox>
          <Button x:Name="CancelButton" Grid.Column="2" Content="停止" Visibility="Collapsed" Click="OnCancel" />
          <Button x:Name="SendButton" Grid.Column="3" Content="发送" Background="{StaticResource AccentGreenBrush}" Click="OnSend" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
