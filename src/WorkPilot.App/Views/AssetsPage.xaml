<Page
    x:Class="WorkPilot.Views.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource AppBackgroundBrush}" Padding="28,22" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="资产" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SpaceName" Foreground="#A8A8A8"/></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <TextBlock x:Name="IndexStatus" VerticalAlignment="Center" Foreground="#A8A8A8"/>
        <Button x:Name="IndexButton" Content="开始 / 重建索引" Click="OnIndex"/>
        <Button x:Name="PauseButton" Content="暂停" Click="OnPause"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" MinHeight="44" PlaceholderText="搜索文件名、路径和文本内容" TextChanged="OnQueryChanged"/>
      <ComboBox x:Name="ProjectFilter" Grid.Column="1" SelectionChanged="OnFilterChanged"/>
      <ComboBox x:Name="CategoryFilter" Grid.Column="2" SelectionChanged="OnFilterChanged">
        <ComboBoxItem Content="全部类型" Tag=""/><ComboBoxItem Content="代码" Tag="code"/><ComboBoxItem Content="文档" Tag="document"/>
        <ComboBoxItem Content="数据" Tag="data"/><ComboBoxItem Content="配置" Tag="config"/><ComboBoxItem Content="其他" Tag="other"/>
      </ComboBox>
      <ComboBox x:Name="StatusFilter" Grid.Column="3" SelectionChanged="OnFilterChanged">
        <ComboBoxItem Content="全部状态" Tag=""/><ComboBoxItem Content="可搜索正文" Tag="indexed"/>
        <ComboBoxItem Content="仅元数据" Tag="metadata_only_type"/><ComboBoxItem Content="文件过大" Tag="metadata_only_size_limit"/>
        <ComboBoxItem Content="不支持编码" Tag="unsupported_encoding"/><ComboBoxItem Content="缺失" Tag="missing"/>
      </ComboBox>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error"/>
        <ListView x:Name="ResultList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="OnResultClick">
          <ListView.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" Background="{StaticResource CardBrush}" CornerRadius="10">
            <StackPanel Spacing="4"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding RelativePath}" Foreground="#A8A8A8" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxLines="2"/>
              <TextBlock Text="{Binding ProjectName}" Foreground="#00BB6B" FontSize="12"/>
            </StackPanel></Border></DataTemplate></ListView.ItemTemplate>
        </ListView>
      </Grid>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
        <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="PreviewTitle" Text="选择资产查看预览" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="PreviewMeta" Grid.Row="1" Foreground="#A8A8A8" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="复制相对路径" Click="OnCopyPath"/><Button Content="加入对话草稿" Click="OnAddToChat"/></StackPanel>
          <ScrollViewer Grid.Row="3"><TextBlock x:Name="PreviewText" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="NoWrap"/></ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
