<Page
    x:Class="WorkPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
    <StackPanel Padding="32,26,32,40" Spacing="18" MaxWidth="820" HorizontalAlignment="Center">
      <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Left" />
      <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="模型服务" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="支持 OpenAI Chat Completions 兼容接口。端点通常以 /v1 结尾。" Foreground="#A8A8A8" TextWrapping="Wrap" />
          <TextBox x:Name="EndpointBox" Header="API 端点" PlaceholderText="https://api.openai.com/v1" />
          <TextBox x:Name="ModelBox" Header="模型" PlaceholderText="gpt-5-mini" />
          <PasswordBox x:Name="ApiKeyBox" Header="API Key" PlaceholderText="留空表示不更改已保存的密钥" />
          <TextBox x:Name="SystemPromptBox" Header="Agent 工作方式" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                   PlaceholderText="例如：修改后先运行测试；回答保持简洁。" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="删除密钥" Click="OnDeleteKey" />
            <Button Content="保存设置" Background="{StaticResource AccentGreenBrush}" Click="OnSave" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22">
        <StackPanel Spacing="12">
          <TextBlock Text="安全与数据" FontSize="19" FontWeight="SemiBold" />
          <InfoBar IsOpen="True" IsClosable="False" Severity="Success" Title="本地优先"
                   Message="会话、项目和自动化保存在本机 SQLite；API Key 使用当前 Windows 用户的 DPAPI 加密，源码与日志均不会记录密钥。" />
          <TextBlock Text="文件安全" FontWeight="SemiBold" />
          <TextBlock Text="C++ 核心在打开句柄后验证最终路径；拒绝绝对路径、目录穿越、符号链接和目录联接。读取上限 512 KiB，写入上限 1 MiB。" TextWrapping="Wrap" Foreground="#A8A8A8" />
          <TextBlock Text="自动化" FontWeight="SemiBold" />
          <TextBlock Text="V1.2 的调度器只在应用运行期间工作，并强制只读。Windows 后台任务与开机自启留待后续版本。" TextWrapping="Wrap" Foreground="#A8A8A8" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Foreground="#00BB6B" HorizontalAlignment="Right" />
    </StackPanel>
  </ScrollViewer>
</Page>
