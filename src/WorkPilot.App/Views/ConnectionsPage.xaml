<Page x:Class="WorkPilot.Views.ConnectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:WorkPilot.Models">
  <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="连接" FontSize="28" FontWeight="SemiBold"/>
    <InfoBar x:Name="InfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
    <Pivot Grid.Row="2">
      <PivotItem Header="连接器">
        <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="添加连接器" Click="OnAddConnector" Background="{StaticResource AccentGreenBrush}"/>
            <Button Content="测试" Click="OnTestConnector"/><Button Content="启用 / 禁用" Click="OnToggleConnector"/><Button Content="删除" Click="OnDeleteConnector"/></StackPanel>
          <ListView x:Name="ConnectorList" Grid.Row="1" Margin="0,12,0,0">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:ConnectorAccount"><Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,8">
              <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind IdentitySummary}" Foreground="#AAA"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind StatusLabel}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Grid>
      </PivotItem>
      <PivotItem Header="MCP 服务">
        <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="添加 MCP 服务" Click="OnAddMcp" Background="{StaticResource AccentGreenBrush}"/>
            <Button Content="连接并刷新" Click="OnRefreshMcp"/><Button Content="启用 / 禁用" Click="OnToggleMcp"/><Button Content="删除" Click="OnDeleteMcp"/></StackPanel>
          <ListView x:Name="McpList" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="OnMcpSelected">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:McpServer"><Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,8">
              <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind TransportLabel}" Foreground="#AAA"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind State}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Grid>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
