<Page x:Class="WorkPilot.Views.PermissionsPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:gov="using:WorkPilot.Domain.PermissionGovernance"
      xmlns:core="using:WorkPilot.App.Core.Permissions">
  <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="权限管理" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="查看有效权限、管理自动化授权、预览并确认策略变更（PER-003/004/008–010）" Foreground="#A8A8A8"/>
    </StackPanel>

    <InfoBar x:Name="InfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error"/>

    <Pivot Grid.Row="2">
      <!-- 有效权限投影 (PER-003) -->
      <PivotItem Header="有效权限">
        <StackPanel Spacing="10" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SourceSchemaBox" Header="来源 Schema 哈希" Width="220" PlaceholderText="如 sch-src（留空视为无）"/>
            <TextBox x:Name="CapabilityIdsBox" Header="能力 StableId（逗号分隔）" Width="320" PlaceholderText="cap-1,cap-2"/>
            <Button Content="投影有效权限" Click="OnProject" VerticalAlignment="Bottom"/>
          </StackPanel>
          <ListView ItemsSource="{x:Bind Vm.EffectivePermissions, Mode=OneWay}" Height="340">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="core:EffectiveCapabilityView">
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind CapabilityStableId}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Decision}"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind EffectiveRisk}"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind PrimaryReasonCode}" Foreground="#999" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </PivotItem>

      <!-- 活动授权 / 撤销 (PER-004) -->
      <PivotItem Header="活动授权">
        <StackPanel Spacing="10" Margin="0,12,0,0">
          <Button Content="刷新授权" Click="OnRefreshGrants"/>
          <ListView ItemsSource="{x:Bind Vm.ActiveGrants, Mode=OneWay}" Height="340">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="gov:PolicyGrant">
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="160"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind CapabilityStableId}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind SourceKind}"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind SourceId}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind ExpiresAtUtc}" Foreground="#999"/>
                    <Button Grid.Column="4" Content="撤销" Command="{x:Bind ElementName=PageRoot, Path=Vm.RevokeGrantCommand}" CommandParameter="{x:Bind GrantId}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </PivotItem>

      <!-- 策略变更：预览影响 + 二次确认保存 (PER-008/009/010) -->
      <PivotItem Header="策略变更">
        <StackPanel Spacing="10" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="LayerBox" Header="编辑层" Width="140"/>
            <TextBox x:Name="EditCapabilityBox" Header="能力 StableId" Width="200" PlaceholderText="cap-x"/>
            <ComboBox x:Name="EffectBox" Header="效果" Width="120"/>
            <ComboBox x:Name="RiskBox" Header="风险上限" Width="120"/>
            <Button Content="预览影响" Click="OnPreview" VerticalAlignment="Bottom"/>
          </StackPanel>
          <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="保存前影响分析"/>
              <TextBlock Text="{x:Bind Vm.ImpactSummary, Mode=OneWay}" TextWrapping="Wrap"/>
              <InfoBar x:Name="ExpansionBar" IsOpen="{x:Bind Vm.RequiresConfirmation, Mode=OneWay}"
                       Severity="Warning" Title="此变更将扩大权限"
                       Message="请确认后点击“确认并保存”；保存将触发撤销纪元（epoch）以使旧授权/票据失效。"/>
              <Button Content="确认并保存" Command="{x:Bind Vm.ConfirmSaveCommand}"
                      IsEnabled="{x:Bind Vm.HasPendingImpact, Mode=OneWay}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
