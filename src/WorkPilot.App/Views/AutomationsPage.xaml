<Page
    x:Class="WorkPilot.Views.AutomationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource AppBackgroundBrush}" Padding="28,24" ColumnSpacing="22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid RowSpacing="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel><TextBlock Text="自动化" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="应用运行期间按计划执行" FontSize="12" Foreground="#A8A8A8"/></StackPanel>
        <Button Content="＋ 新建" HorizontalAlignment="Right" Click="OnNew" />
      </Grid>
      <ListView x:Name="AutomationList" Grid.Row="1" SelectionChanged="OnSelected" Background="Transparent">
        <ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="8" Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LastStatus}" FontSize="12" Foreground="#A8A8A8" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
      <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
        <TextBlock Text="计划任务" FontSize="20" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Header="名称" PlaceholderText="例如：每小时检查项目状态" />
        <TextBox x:Name="PromptBox" Header="任务指令" MinHeight="170" AcceptsReturn="True" TextWrapping="Wrap" />
        <NumberBox x:Name="IntervalBox" Header="间隔（分钟）" Minimum="1" Maximum="10080" Value="60" SpinButtonPlacementMode="Inline" />
        <ToggleSwitch x:Name="EnabledSwitch" Header="状态" OnContent="已启用" OffContent="已暂停" />
        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="V1.2 自动化仅在 WorkPilot 运行时触发，并固定使用只读权限；不会在后台静默修改文件。" />
        <TextBlock x:Name="RunInfo" Foreground="#A8A8A8" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button x:Name="DeleteButton" Content="删除" Click="OnDelete" />
          <Button Content="保存" Background="{StaticResource AccentGreenBrush}" Click="OnSave" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>

