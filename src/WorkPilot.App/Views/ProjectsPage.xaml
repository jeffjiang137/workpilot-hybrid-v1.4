<Page
    x:Class="WorkPilot.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource AppBackgroundBrush}" Padding="28,24" ColumnSpacing="22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid RowSpacing="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <TextBlock Text="项目" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="＋ 新建" HorizontalAlignment="Right" Click="OnNew" />
      </Grid>
      <ListView x:Name="ProjectList" Grid.Row="1" SelectionChanged="OnSelected" Background="Transparent">
        <ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="8" Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding WorkspacePath}" Foreground="#A8A8A8" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
      <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
        <TextBlock Text="项目详情" FontSize="20" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Header="名称" PlaceholderText="例如：网站重构" />
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="PathBox" Header="本地工作区" IsReadOnly="True" PlaceholderText="选择一个本地文件夹" />
          <Button Grid.Column="1" Content="选择文件夹" VerticalAlignment="Bottom" Click="OnPickFolder" />
        </Grid>
        <TextBox x:Name="InstructionsBox" Header="项目说明" MinHeight="180" AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="告诉 Agent 项目目标、技术栈、运行命令和禁止修改的范围。" />
        <TextBox x:Name="IgnoreRulesBox" Header="资产忽略规则（每行一条 glob）" MinHeight="90" AcceptsReturn="True"
                 PlaceholderText="例如：temp/**" />
        <ToggleSwitch x:Name="IncludeHiddenSwitch" Header="包含隐藏文件" OffContent="不包含" OnContent="包含"/>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="IndexStatusText" Text="尚未索引" Foreground="#A8A8A8" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="开始索引" Click="OnIndex"/>
          <Button Grid.Column="2" Content="暂停" Click="OnPauseIndex"/>
        </Grid>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="C++ 核心会把所有文件工具限制在该目录内，并拒绝符号链接和目录联接。" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button x:Name="DeleteButton" Content="删除" Click="OnDelete" />
          <Button Content="保存项目" Background="{StaticResource AccentGreenBrush}" Click="OnSave" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>
